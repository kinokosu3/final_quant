{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/qlib_bt/llm_agent_summary.schema.json",
  "title": "Backtest LLM Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "executive_summary",
    "performance",
    "benchmarks",
    "pipeline",
    "risk",
    "factors",
    "findings",
    "experiments",
    "red_flags"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["out_dir", "start", "end"],
      "properties": {
        "out_dir": {"type": "string"},
        "start": {"type": "string"},
        "end": {"type": "string"},
        "git_head": {"type": ["string", "null"]}
      }
    },
    "executive_summary": {
      "type": "array",
      "items": {"type": "string"},
      "maxItems": 5
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_risk", "post_risk", "delta"],
      "properties": {
        "pre_risk": {"$ref": "#/$defs/strategyMetrics"},
        "post_risk": {"$ref": "#/$defs/strategyMetrics"},
        "delta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delta_ann_return", "delta_max_drawdown"],
          "properties": {
            "delta_ann_return": {"type": ["number", "null"]},
            "delta_max_drawdown": {"type": ["number", "null"]}
          }
        }
      }
    },
    "benchmarks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list", "excess_ann_return"],
      "properties": {
        "list": {"type": "array", "items": {"type": "string"}},
        "excess_ann_return": {
          "type": "object",
          "additionalProperties": {"type": ["number", "null"]}
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "filters", "turnover"],
      "properties": {
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["universe_mean", "eligible_mean"],
          "properties": {
            "universe_mean": {"type": ["number", "null"]},
            "eligible_mean": {"type": ["number", "null"]}
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liquidity_bind_rate", "tradable_bind_rate"],
          "properties": {
            "liquidity_bind_rate": {"type": ["number", "null"]},
            "tradable_bind_rate": {"type": ["number", "null"]}
          }
        },
        "turnover": {
          "type": "object",
          "additionalProperties": false,
          "required": ["weekly_avg_pre_risk", "weekly_avg_post_trend"],
          "properties": {
            "weekly_avg_pre_risk": {"type": ["number", "null"]},
            "weekly_avg_post_trend": {"type": ["number", "null"]}
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trend", "stop_loss"],
      "properties": {
        "trend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ma", "risk_off_scale", "trigger_rate"],
          "properties": {
            "ma": {"type": "integer"},
            "risk_off_scale": {"type": "number"},
            "trigger_rate": {"type": ["number", "null"]}
          }
        },
        "stop_loss": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold", "events_count"],
          "properties": {
            "threshold": {"type": ["number", "null"]},
            "events_count": {"type": "integer"}
          }
        }
      }
    },
    "factors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {
        "signals": {
          "type": "array",
          "items": {"$ref": "#/$defs/factorSignal"}
        }
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_sanity", "performance", "pipeline", "risk", "factors"],
      "properties": {
        "data_sanity": {"type": "array", "items": {"type": "string"}},
        "performance": {"type": "array", "items": {"type": "string"}},
        "pipeline": {"type": "array", "items": {"type": "string"}},
        "risk": {"type": "array", "items": {"type": "string"}},
        "factors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "experiments": {
      "type": "array",
      "items": {"$ref": "#/$defs/experiment"},
      "maxItems": 5
    },
    "red_flags": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "strategyMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ann_return", "ann_vol", "sharpe", "max_drawdown"],
      "properties": {
        "ann_return": {"type": ["number", "null"]},
        "ann_vol": {"type": ["number", "null"]},
        "sharpe": {"type": ["number", "null"]},
        "max_drawdown": {"type": ["number", "null"]}
      }
    },
    "factorSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ic_ir", "ic_mean", "spread_ir", "turnover"],
      "properties": {
        "name": {"type": "string"},
        "ic_ir": {"type": ["number", "null"]},
        "ic_mean": {"type": ["number", "null"]},
        "spread_ir": {"type": ["number", "null"]},
        "turnover": {"type": ["number", "null"]}
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change", "hypothesis", "expected_metrics", "hold_constant", "compare"],
      "properties": {
        "change": {"type": "string"},
        "hypothesis": {"type": "string"},
        "expected_metrics": {"type": "array", "items": {"type": "string"}},
        "hold_constant": {"type": "string"},
        "compare": {"type": "string"}
      }
    }
  }
}
